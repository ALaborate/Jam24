  - m_Id: 1464968921088
    m_Localized: "\u0426\u0435\u0439 WEB GL \u0431\u0456\u043B\u0434 \u0442\u0456\u043B\u044C\u043A\u0438
      \u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0430\u0446\u0456\u0439\u043D\u0438\u0439
      \u0442\u0430 \u044F\u043A \u0432\u0430\u0436\u043A\u043E \u0440\u043E\u0437\u0456\u0431\u0440\u0430\u0442\u0438\u0441\u044C
      \u044F\u043A \u0439\u043E\u0433\u043E \u043A\u043E\u043D\u0435\u043A\u0442\u0438\u0442\u0438
      \u0434\u043E \u0437\u043E\u0432\u043D\u0456\u0448\u043D\u044C\u043E\u0433\u043E
      \u0441\u0435\u0440\u0432\u0435\u0440\u0430. \u0422\u0443\u0442 \u043C\u043E\u0436\u043D\u0430
      \u0442\u0456\u043B\u044C\u043A\u0438 \u043C\u0435\u043C\u0430\u0441\u0438\u043A\u0438
      \u043F\u043E\u0437\u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0438, \u0430
      \u0449\u043E\u0431 \u043C\u0430\u0442\u0438 \u043C\u0443\u043B\u044C\u0442\u0438\u043F\u043B\u0435\u0439\u0454\u0440,
      \u0431\u0443\u0434\u044C \u0432\u0430\u0448\u0430 \u043B\u0430\u0441\u043A\u0430,
      \u043A\u0430\u0447\u0430\u0439\u0442\u0435 \u0434\u0435\u0441\u043A\u0442\u043E\u043F\u043D\u0438\u0439
      \u0430\u0431\u043E \u043C\u043E\u0431\u0456\u043B\u044C\u043D\u0438\u0439 \u0431\u0456\u043B\u0434"
